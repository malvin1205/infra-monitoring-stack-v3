# Copy to .env and fill in. Generate values with: openssl rand -hex 32

# Required — protects all state-changing /api/* endpoints (X-API-Key header
# or "Authorization: Bearer <key>").
INFRAWATCH_API_KEY=

# Required — protects POST /webhook (X-Webhook-Secret header or ?secret=).
# Point Alertmanager's webhook_configs url at /webhook?secret=<this value>.
WEBHOOK_SECRET=

PROMETHEUS_URL=http://prometheus:9090
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true
