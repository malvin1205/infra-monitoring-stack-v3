# Environment configuration for InfraWatch v3
# Optional — If left blank, InfraWatch automatically generates cryptographically
# secure 64-hex tokens on first run and persists them to alarm/.api_key and alarm/.webhook_secret.

# Optional override — protects all state-changing /api/* endpoints (X-API-Key header
# or "Authorization: Bearer <key>").
INFRAWATCH_API_KEY=

# Optional override — protects POST /webhook (X-Webhook-Secret header or ?secret=).
# Point Alertmanager's webhook_configs url at /webhook?secret=<this value>.
WEBHOOK_SECRET=

PROMETHEUS_URL=http://prometheus:9090
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

