# Auto-generated per-deployment secrets — must never be baked into an image
# layer (a shared image would then ship a known session-signing key / API key,
# allowing forged admin sessions). They are regenerated on first run, or
# mounted, at the target.
.api_key
.webhook_secret
.session_secret

